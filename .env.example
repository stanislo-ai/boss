# Skopiuj do .env (lokalnie). Na Vercel te same zmienne wpisujesz w Settings → Environment Variables.

# Baza Turso (https://app.turso.tech). Puste = lokalny plik data/biznescreator.db
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Adres strony – od niego zależą linki aktywacyjne.
BASE_URL=http://localhost:3000

# Opcjonalnie: klucz Google Places API (New). Puste = tylko darmowe OpenStreetMap.
GOOGLE_PLACES_API_KEY=
GOOGLE_MONTHLY_CAP=900
