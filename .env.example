# Skopiuj do .env i uzupełnij.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
BASE_URL=https://biznescreator.pl
# Ustaw 1, jeśli aplikacja stoi za nginx / Cloudflare (prawdziwe IP klienta dla limitów).
TRUST_PROXY=1
SESSION_DAYS=7
# Opcjonalnie: klucz Google Places API (New). Puste = tylko darmowe OpenStreetMap.
GOOGLE_PLACES_API_KEY=
# Twardy limit zapytań do Google na miesiąc (żeby zostać w darmowym progu).
GOOGLE_MONTHLY_CAP=900
